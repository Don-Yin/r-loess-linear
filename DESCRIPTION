Package: loesslin
Type: Package
Title: Memory-Efficient Standard Errors for Loess Predictions
Version: 0.0.1
Authors@R: c(
    person("Don", "Yin", email = "Don_Yin@outlook.com",
           role = c("aut", "cre", "cph")),
    person("R Core Team", role = c("ctb", "cph")),
