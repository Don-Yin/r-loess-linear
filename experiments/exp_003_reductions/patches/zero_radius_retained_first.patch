+/* Give exceptional vertices the first retention slots without another QR pass.
+ * Earlier finite records remain exactly reconstructible after their slot is reused. */
+void F77_SUB(fretain)(int *vertex,int *rs,double *record,int *keepof,
+    int *exceptional,int *slot)
+{
+    int l=*vertex-1,nonfinite=!(record[*rs-1]>0.);
+    for(int i=0;i<*rs;++i)if(!R_FINITE(record[i]))nonfinite=1;
+    exceptional[l]=nonfinite;
+    *slot=0;
+    if(nonfinite&&!keepof[l])for(int i=l-1;i>=0;--i)
+        if(keepof[i]&&!exceptional[i]) {
+            *slot=keepof[l]=keepof[i];keepof[i]=0;return;
+        }
 }
 
