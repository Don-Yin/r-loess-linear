+c One design-row expression for producer and scalar reconstruction.
+      subroutine loessfeatures(d,degree,cdeg,q,x,stride,w,out,ld,col)
+      integer d,degree,cdeg(*),stride,ld,col,j,jj
+      double precision q(*),x(*),w,out(*),qj,qjj
+      col=1
+      out(1)=w
+      if(degree.ge.1)then
+         do 1 j=1,d
+            if(cdeg(j).ge.1)then
+               col=col+1
+               qj=q(j)
+               out(1+(col-1)*ld)=w*(x(1+(j-1)*stride)-qj)
+            end if
+    1    continue
+      end if
+      if(degree.ge.2)then
+         do 2 j=1,d
+            if(cdeg(j).ge.1)then
+               qj=q(j)
+               if(cdeg(j).ge.2)then
+                  col=col+1
+                  out(1+(col-1)*ld)=w*(x(1+(j-1)*stride)-qj)**2
+               end if
+               do 3 jj=j+1,d
+                  if(cdeg(jj).ge.1)then
+                     col=col+1
+                     qjj=q(jj)
+                     out(1+(col-1)*ld)=w*(x(1+(j-1)*stride)-qj)*
+     +                    (x(1+(jj-1)*stride)-qjj)
+                  end if
+    3          continue
+            end if
+    2    continue
+      end if
+      return
+      end
